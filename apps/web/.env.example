# SmartRouter web — public config only (every key is NEXT_PUBLIC_* and ships in the browser bundle).
# Never put provider keys, the operator key, the Tempo hot wallet or a paid RPC key URL here.
#
# Monad handoff ("Required production configuration"):
#   NEXT_PUBLIC_API_URL        https://smartrouter-mon-77e0210bcfa8.herokuapp.com
#   NEXT_PUBLIC_CHAIN_ID       143 (Monad mainnet; the default)
#   NEXT_PUBLIC_RPC_URL        https://rpc.monad.xyz (public RPC only; the default)
#   NEXT_PUBLIC_PRIVY_APP_ID   cmv7760bf00ps0gl39z69z4e6 (Privy app "smartmon"; never the app secret)
#
# Tempo is backend infrastructure (SmartRouter pays AI providers there); the browser never uses it.
#
# Before a new frontend URL works: add its exact origin to APP_ORIGINS on the Heroku app
# (smartrouter-mon) and to the allowed origins of the Privy app.

# --- required -------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://smartrouter-mon-77e0210bcfa8.herokuapp.com
NEXT_PUBLIC_CHAIN_ID=143
NEXT_PUBLIC_RPC_URL=https://rpc.monad.xyz
NEXT_PUBLIC_PRIVY_APP_ID=cmv7760bf00ps0gl39z69z4e6

# --- optional -------------------------------------------------------------------------------
# Object-storage host for generated images and songs (hostname only, used for next/image + CSP)
NEXT_PUBLIC_OBJECT_STORAGE_HOST=

# Sentry (browser). Empty = monitoring off.
NEXT_PUBLIC_SENTRY_DSN=

# Feature flags (PDF cut order: Compare first, then music). 1 = on.
NEXT_PUBLIC_FLAG_COMPARE=1
NEXT_PUBLIC_FLAG_MUSIC=1

# Run fully offline against the MSW mock API (dev/tests only — never set on Vercel).
NEXT_PUBLIC_MOCK=0
